[Unit]
Description=Barchart Pro Bot (headless Chrome + Selenium)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/uw-options-bot/barchart_bot
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/ubuntu
ExecStart=/home/ubuntu/uw-options-bot/barchart_bot/venv/bin/python barchart_pro_bot.py
# v18.1: bot stays up 24/7 - after 16:30 ET (and on weekends/NYSE holidays) it closes
# Chrome and sleeps until 09:00 ET next trading day. The timer is only a safety net.
Restart=on-failure
RestartSec=120
KillMode=control-group
TimeoutStopSec=30
Nice=5
