# v18 accuracy tuning -- loaded AFTER .env and overrides it.
# Change values here, push, then on the VM: git pull && sudo systemctl restart barchartbot
# Every change should be judged on evaluation_report.txt (evaluate_signals.py), not on feel.

# --- Outcome labels / learning -------------------------------------------
MONITOR_USE_OPTION_PRICE=true        # judge target/stop on the option's real price (Schwab)
MONITOR_SHADOW_MODE=true             # still log the old stock-proxy verdict for comparison
ENABLE_WIN_RATE_AUTO_FILTERING=false # old labels were wrong; re-enable after relabelled history

# --- Buy vs sell (aggressor side) ----------------------------------------
REQUIRE_BUY_SIDE_FOR_SIGNAL=true     # only buyer-initiated prints can become signals
EXCLUDE_MULTI_LEG_FLOW=true          # spreads / stock-tied prints carry no clear direction
SIDE_BUY_THRESHOLD=0.75              # trade in top 25% of the spread = buy
SIDE_SELL_THRESHOLD=0.25             # trade in bottom 25% of the spread = sell

# --- Direction / market ---------------------------------------------------
ENABLE_PUT_SIGNALS=false             # puts won 34% in history (random entries ~50%)
REQUIRE_DAILY_TREND_ALIGNMENT=true   # calls only when SPY & QQQ are above their 20-day SMA

# --- TRADE gates ----------------------------------------------------------
REQUIRE_PRICE_REACTION_FOR_TRADE=true
HARD_OPTION_TIME_WINDOW=true
OPTION_MORNING_START_HOUR=9
OPTION_MORNING_START_MINUTE=45
OPTION_MORNING_END_HOUR=11
OPTION_MORNING_END_MINUTE=0
OPTION_AFTERNOON_START_HOUR=13
OPTION_AFTERNOON_START_MINUTE=0
OPTION_AFTERNOON_END_HOUR=15
OPTION_AFTERNOON_END_MINUTE=0
TRADE_MIN_SCORE=30
TRADE_MIN_CONFIRMATIONS=4
BLOCK_MAX_DTE_LOTTERY=1
BLOCK_MIN_DELTA=0.15
ONE_ALERT_PER_TICKER_DIRECTION_DAY=true

# --- Scoring tweaks -------------------------------------------------------
IV_PCT_LOW_BONUS=0                   # low IV did worst (38%) -- no bonus
