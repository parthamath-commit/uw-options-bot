# ─────────────────────────────────────────────────────────────
# UW Options Bot v1.0 — .env
# cp .env.template .env  then fill in your values
# ─────────────────────────────────────────────────────────────

# ── Unusual Whales API ────────────────────────────────────────
# Get your Bearer token: unusualwhales.com/pricing?product=api
UW_API_KEY=your_bearer_token_here

# ── IBKR ─────────────────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497              # 7497=TWS paper/live | 4001=IB Gateway
IBKR_CLIENT_ID=10
IBKR_ACCOUNT=               # Pal Initiatives LLC account ID e.g. U1234567

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Output ───────────────────────────────────────────────────
EXCEL_PATH=output/signals.xlsx

# ── Watchlist ────────────────────────────────────────────────
WATCHLIST=SPY,QQQ,NVDA,AAPL,MSFT,TSLA,AMZN,META,GOOGL,AMD,MU,AVGO

# ── Scoring ──────────────────────────────────────────────────
MIN_SCORE_ALERT=60          # Alert threshold
MIN_ALERT_PREMIUM=500000    # $500k minimum total premium to alert          # Alert threshold -- tracker evaluates all scores for analysis
MIN_SCORE_LOG=50            # Excel log threshold

# ── Risk / sizing ─────────────────────────────────────────────
PORTFOLIO_SIZE=100000       # fallback if IBKR unreachable
MAX_RISK_PCT=0.01           # 1% per trade
TARGET_GAIN_PCT=0.65        # +65% premium exit target

# ── Option filters ────────────────────────────────────────────
TARGET_DELTA_MIN=0.20       # OTM to ITM range (most unusual flow is OTM)
TARGET_DELTA_MAX=0.90
MIN_DTE=0                   # include near-term/weekly flow (was 14)
MAX_DTE=60                  # widen to catch longer-dated institutional flow (was 28)

# ── GEX regime block ──────────────────────────────────────────
# Block bullish CALL signals when SPY GEX < this ($M)
GEX_BLOCK_THRESHOLD=-500

# ── Scan interval ─────────────────────────────────────────────
SCAN_INTERVAL_SEC=180       # 3 minutes
